         <enum>Qt::CustomContextMenu</enum>
        </property>
        <property name="styleSheet">
         <string notr="true">QTableView::item {
    text-align: center; /* 表格项文本居中 */
    vertical-align: middle; /* 垂直居中文本 */
}
QHeaderView
{
	
    background:transparent;
}

QHeaderView::section
{
	border-radius:3px; 
    font-size:7px;
    font-family:&quot;Microsoft YaHei&quot;;
    color:rgb(133, 133, 133);
    background:rgb(255, 255, 255);
    border:none;
    text-align:center;
    min-height:23px;
    max-height:23px;
    margin-right:1px;
    padding-left:0px;
}

QTableWidget
{
	show-grid: false;
    background:#FFFFFF;
    border: none;
    font-size:7px;
    font-family:&quot;Microsoft YaHei&quot;;
    color:rgb(149, 149, 149);
}
QTableWidget::item
{
  

}

QTableWidget::item::selected
{
    color:#000000;
    background:#EFF4FF;
}

QScrollBar:vertical
{
    width:8px;

}


QScrollBar::handle:vertical
{
	width: 8px;
    background: #E8E8E8;
    border: 0px solid grey;
    border-radius:2px;
   
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical
{
    background:rgba(255,255,255,10%);
}


QScollBar::add-line:vertical, QScrollBar::sub-line:vertical
{
    background:transparent;
}

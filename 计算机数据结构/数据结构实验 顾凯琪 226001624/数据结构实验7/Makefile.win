CPP      = g++.exe
CC       = gcc.exe
WINDRES  = windres.exe
OBJ      = 数据结构实验7/main.o 数据结构实验7/huffman_encoder.o
LINKOBJ  = 数据结构实验7/main.o 数据结构实验7/huffman_encoder.o
LIBS     = -L"D:/edge下载/MinGW/lib" -L"D:/edge下载/MinGW/x86_64-w64-mingw32/lib" -static-libstdc++ -static-libgcc
INCS     = -I"D:/edge下载/MinGW/include" -I"D:/edge下载/MinGW/x86_64-w64-mingw32/include" -I"D:/edge下载/MinGW/lib/gcc/x86_64-w64-mingw32/11.2.0/include"
CXXINCS  = -I"D:/edge下载/MinGW/include" -I"D:/edge下载/MinGW/x86_64-w64-mingw32/include" -I"D:/edge下载/MinGW/lib/gcc/x86_64-w64-mingw32/11.2.0/include"
BIN      = 项目1.exe
CXXFLAGS = $(CXXINCS) 
CFLAGS   = $(INCS) 
RM       = rm.exe -f

.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

clean: clean-custom
	${RM} $(OBJ) $(BIN)

$(BIN): $(OBJ)
	$(CPP) $(LINKOBJ) -o $(BIN) $(LIBS)

数据结构实验7/main.o: 数据结构实验7/main.cpp
	$(CPP) -c 数据结构实验7/main.cpp -o 数据结构实验7/main.o $(CXXFLAGS)

数据结构实验7/huffman_encoder.o: 数据结构实验7/huffman_encoder.cpp

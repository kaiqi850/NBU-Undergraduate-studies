function data_error(err_url){var img=document.getElementsByTagName("img");for(var i=0;i<img.length;i++){var att=img[i].getAttribute("data");if(att!=""&&att!=null){(function(a,b){var pic=new Image();pic.src=b;pic.onload=function(){pic.onload=null;img[a].src=b};pic.onerror=function(){pic.onerror=null;img[a].src=err_url}})(i,att)}}};